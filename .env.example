# ==================== Telegram Bot ====================
BOT_TOKEN=your_bot_token_here

# Admin Telegram user IDs (comma-separated, NO spaces)
ADMIN_IDS=6560945590

# ==================== Group & Topics ====================
# Private group ID (starts with -100...)
GROUP_ID=-1001234567890
# Topic thread IDs inside the group
TOPIC_RAW_ID=1
TOPIC_MINIMAL_ID=2

# ==================== Database ====================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/telegrambot

# ==================== Bank / Payment ====================
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME=NGUYEN VAN A
BANK_NAME=Vietcombank

# ==================== Sieuthicode API ====================
# API endpoint to fetch bank transaction history
SIEUTHICODE_API_URL=https://api.sieuthicode.net/historyapivcbv2/YOUR_API_KEY
# Cookie for authentication
SIEUTHICODE_COOKIE=PHPSESSID=your_session_id_here

# ==================== VietQR ====================
# Bank ID for QR generation (VCB=970436, MB=970422, TCB=970407, ACB=970416)
SIEUTHICODE_BANK_ID=970436
# Override only if you need a different template
# VIETQR_IMAGE_TEMPLATE=https://img.vietqr.io/image/{bank_id}-{account_no}-compact2.jpg

# ==================== Payment Monitoring ====================
# How long to watch for payment after QR is sent (seconds)
PAYMENT_WATCH_SECONDS=300
# How often to poll sieuthicode (seconds)
PAYMENT_POLL_INTERVAL_SECONDS=15

# ==================== App Settings ====================
TIMEZONE=Asia/Ho_Chi_Minh
# Pending order expires after this many hours if not paid
ORDER_EXPIRY_HOURS=24
DEBUG=false
